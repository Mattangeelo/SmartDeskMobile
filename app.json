{
  "expo": {
    "name": "SmartDesk",
    "slug": "smartdesk-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o SmartDesk acesse suas fotos para anexar imagens aos tickets."
        }
      ],
      "expo-status-bar"
    ],
    "splash": {
      "backgroundColor": "#1e1e1e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartdesk.mobile"
    },
    "android": {
      "package": "com.smartdesk.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://10.10.38.9/api"
    }
  }
}
